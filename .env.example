# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - GRUPO 4 (EXEMPLO)
# Copie este arquivo para .env e preencha com sua chave real
# ==============================================================================

# Porta onde o servidor Node.js irá rodar
PORT=3000

# Escolha do provedor de LLM: 'gemini', 'openai' ou 'anthropic'
PROVIDER=gemini

# Chave de API do Google Gemini (Obtida gratuitamente em https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# Chaves opcionais para demonstração
OPENAI_API_KEY=sua_chave_da_openai_aqui
ANTHROPIC_API_KEY=sua_chave_da_anthropic_aqui
